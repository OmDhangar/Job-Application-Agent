# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobos:password@localhost:5432/jobos
DB_PASSWORD=changeme

# ── Cache / Queue ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://jobos:changeme@localhost/
RABBITMQ_PASSWORD=changeme

# ── AI: Cloud ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── AI: Local (Ollama must be running on host) ────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e4b-it-q4_K_M
# Pull with: ollama pull gemma3n:e4b-it-q4_K_M

# ── Embeddings (downloaded automatically by sentence-transformers) ──
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda   # or "cpu" if no GPU

# ── Scraping ──────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
SCRAPER_THROTTLE_MS=2000

# ── Security ──────────────────────────────────────────────
SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Dev ───────────────────────────────────────────────────
DEBUG=false

# ── Optional: Serper for web search in agents ─────────────
SERPER_API_KEY=your-serper-key-here
